NEXT_PUBLIC_SITE_URL=
ENVIRONMENT=production

# SUPABASE
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_REQUIRE_EMAIL_CONFIRMATION=true

## THESE VARIABLES MUST BE ADDED USING THE CI/CD ENVIRONMENT VARIABLES
SUPABASE_SERVICE_ROLE_KEY=

# STRIPE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

## THESE VARIABLES MUST BE ADDED USING THE CI/CD ENVIRONMENT VARIABLES
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=

# EMAIL
## THESE VARIABLES MUST BE ADDED USING THE CI/CD ENVIRONMENT VARIABLES
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_SENDER='Ultaura Team <support@ultaura.com>'
EMAIL_TLS=true

# FEATURE FLAGS
NEXT_PUBLIC_ENABLE_ACCOUNT_DELETION=true
NEXT_PUBLIC_ENABLE_ORGANIZATION_DELETION=false
NEXT_PUBLIC_ENABLE_TEAM_ACCOUNTS=false
NEXT_PUBLIC_ENABLE_TEAM_ACCOUNTS_BILLING=false

# NEWSLETTER (RESEND)
RESEND_API_KEY=
RESEND_SEGMENT_ID=
RESEND_TOPIC_BLOG_DIGEST_ID=
RESEND_TOPIC_ELDER_CARE_TIPS_ID=
RESEND_TOPIC_PRODUCT_UPDATES_ID=
RESEND_WEBHOOK_SECRET=
RESEND_FROM_EMAIL=Ultaura <newsletter@ultaura.com>
ULTAURA_INTERNAL_API_SECRET=
RESEND_AUDIENCE_SECRET=

ULTAURA_LOG_PII_KEY=
