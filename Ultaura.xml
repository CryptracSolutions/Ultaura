  try {
    const { callSessionId, lineId, category } = req.body as {
      callSessionId?: string;
      lineId?: string;
      category?: ExclusionCategory;
    };

    if (!callSessionId || !lineId || !category) {
      res.status(400).json({ error: 'Missing required fields' });
