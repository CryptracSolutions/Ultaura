      .from('ultaura_reminders')
      .update({
        is_paused: false,
        paused_at: null,
        current_snooze_count: 0, // Reset snooze count on resume
      })
      .eq('id', reminderId);

    if (updateError) {
      logger.error({ error: updateError }, 'Failed to resume reminder');
      await recordFailure(updateError.code);
