import { excludeTopic, EXCLUSION_DISPLAY_NAMES, type ExclusionCategory } from '../../services/topic-exclusions.js';

export const excludeTopicRouter = Router();

const VALID_CATEGORIES: ExclusionCategory[] = [
  'health_medical',
  'family_relationships',
  'finances',
