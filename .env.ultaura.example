# ============================================
# ULTAURA ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env.local and fill in your values
# All ULTAURA_* variables are specific to the Ultaura application
# ============================================

# ============================================
# ULTAURA CORE CONFIGURATION (Required)
# ============================================

# Encryption key for memory storage (AES-256-GCM)
# Generate with: openssl rand -hex 32
# MUST be exactly 64 hexadecimal characters
ULTAURA_ENCRYPTION_KEY=
# Optional: previous key used temporarily during KEK rotation
# ULTAURA_ENCRYPTION_KEY_PREVIOUS=

# Internal API authentication between Next.js and telephony backend
# Generate with: openssl rand -hex 32
ULTAURA_INTERNAL_API_SECRET=
# Optional: account ID targeted by /api/internal/crypto-health checks
# ULTAURA_CRYPTO_HEALTH_ACCOUNT_ID=
# Optional: alert threshold per 15-minute process window when reminder search hash fallback is used
# ULTAURA_SEARCH_HASH_FALLBACK_ALERT_THRESHOLD=25

# Optional: Secret for notification recipient tokens (defaults to ULTAURA_INTERNAL_API_SECRET)
ULTAURA_NOTIFICATION_TOKEN_SECRET=

# Telephony backend URLs
# ULTAURA_BACKEND_URL: Internal URL (used by Next.js to call telephony)
# ULTAURA_PUBLIC_URL: Public URL (used by Twilio webhooks)
# ULTAURA_WEBSOCKET_URL: WebSocket URL for Twilio Media Streams
ULTAURA_BACKEND_URL=http://localhost:3001
# Optional (telephony): Use a pod-local URL for internal tool calls to avoid cross-pod routing.
# Recommended for multi-instance deployments.
# ULTAURA_INTERNAL_BACKEND_URL=http://127.0.0.1:3001
ULTAURA_PUBLIC_URL=https://your-telephony-server.com
ULTAURA_WEBSOCKET_URL=wss://your-telephony-server.com/twilio/media

# Web app URL (defaults to NEXT_PUBLIC_SITE_URL if unset)
ULTAURA_APP_URL=http://localhost:3000

# ============================================
# TWILIO CONFIGURATION (Required)
# ============================================
# Get these from https://console.twilio.com

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Answering Machine Detection (optional, default: true)
TWILIO_AMD_ENABLED=true

# Skip signature validation in development only (default: false)
# SKIP_TWILIO_SIGNATURE_VALIDATION=false

# ============================================
# RATE LIMITING (Upstash Redis)
# ============================================
# Required for distributed rate limiting. Leave unset to bypass rate limiting
# with audit logging (not recommended for production).

UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# Optional overrides (defaults shown)
# RATE_LIMIT_VERIFY_SEND_PER_PHONE=5
# RATE_LIMIT_VERIFY_CHECK_PER_PHONE=10
# RATE_LIMIT_PER_IP=20
# RATE_LIMIT_PER_ACCOUNT=10
# RATE_LIMIT_SMS_PER_ACCOUNT=15
# RATE_LIMIT_EMAIL_PER_ACCOUNT=15
# RATE_LIMIT_REMINDERS_PER_SESSION=5
# ANOMALY_COST_THRESHOLD=10.00
# ANOMALY_REPEATED_HITS_THRESHOLD=3
# ANOMALY_ENUMERATION_THRESHOLD=10

# ============================================
# WEBSOCKET SECURITY (Required)
# ============================================
# Secret for signing WebSocket stream tokens (min 32 chars)
# Generate with: openssl rand -hex 32
ULTAURA_STREAM_TOKEN_SECRET=

# Optional: Previous secret during key rotation
# ULTAURA_STREAM_TOKEN_SECRET_PREVIOUS=

# Security mode: audit (log only) or enforce (reject invalid)
# SECURITY: Production must use enforce.
ULTAURA_WS_SECURITY_MODE=enforce

# Development only: allow connections from any IP (default: false)
# TWILIO_MEDIA_IP_ALLOW_UNKNOWN=false

# Optional: Override Twilio IP ranges (comma-separated CIDRs)
# TWILIO_MEDIA_IP_ALLOWLIST=168.86.128.0/18,34.203.254.0/24

# ============================================
# XAI GROK VOICE AGENT (Required)
# ============================================
# Get API key from https://console.x.ai

XAI_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
XAI_GROK_MODEL=grok-3-fast

# xAI Realtime WebSocket URL (optional, has default)
# XAI_REALTIME_URL=wss://api.x.ai/v1/realtime

# ============================================
# EMBEDDINGS / SEMANTIC SEARCH (Recommended)
# ============================================
# OpenAI API key for embedding fallback
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Embedding models (optional overrides)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# XAI_EMBEDDING_MODEL=grok-embedding-small

# Feature toggles and tuning
# ULTAURA_SEMANTIC_SEARCH_ENABLED=true
# ULTAURA_EMBEDDING_SIMILARITY_THRESHOLD=0.7
# ULTAURA_EMBEDDING_BATCH_SIZE=10

# ============================================
# SAFETY BACKSTOP (Optional)
# ============================================
# ULTAURA_MULTILINGUAL_SAFETY_ENABLED=false
# ULTAURA_SAFETY_SWEEPS_ENABLED=true
# ULTAURA_SAFETY_VERIFIER_GATE_ENABLED=true
# ULTAURA_SAFETY_CLASSIFIER_MODEL=gpt-4o-mini

# ============================================
# MEMORY SYSTEM CONTROLS (Optional)
# ============================================
# ULTAURA_TOPIC_EXCLUSIONS_ENABLED=true
# ULTAURA_MEMORY_DECAY_ENABLED=true
# ULTAURA_DECAY_RATE=0.20
# ULTAURA_DECAY_THRESHOLD=0.5
# ULTAURA_DECAY_CRON=0 3 * * *
# ULTAURA_PER_LINE_DEK_ENABLED=true
# ULTAURA_PER_LINE_DEK_CUTOFF=2026-03-01T00:00:00Z

# ============================================
# STRIPE BILLING (Required for paid features)
# ============================================
# Price IDs from your Stripe Dashboard

STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

STRIPE_ULTAURA_CARE_MONTHLY_PRICE_ID=price_xxxxxxxxxxxxxxxx
STRIPE_ULTAURA_COMFORT_MONTHLY_PRICE_ID=price_xxxxxxxxxxxxxxxx
STRIPE_ULTAURA_FAMILY_MONTHLY_PRICE_ID=price_xxxxxxxxxxxxxxxx

STRIPE_ULTAURA_CARE_ANNUAL_PRICE_ID=price_xxxxxxxxxxxxxxxx
STRIPE_ULTAURA_COMFORT_ANNUAL_PRICE_ID=price_xxxxxxxxxxxxxxxx
STRIPE_ULTAURA_FAMILY_ANNUAL_PRICE_ID=price_xxxxxxxxxxxxxxxx

STRIPE_ULTAURA_PAYG_PRICE_ID=price_xxxxxxxxxxxxxxxx
STRIPE_ULTAURA_OVERAGE_PRICE_ID=price_xxxxxxxxxxxxxxxx

# ============================================
# OPTIONAL CONFIGURATION
# ============================================

# Server port (standard Node.js convention)
# PORT=3001

# Enable debug logging (default: false)
# ULTAURA_DEBUG=false

# Debug log retention in days (default: 3)
# DEBUG_LOG_RETENTION_DAYS=3

# Default timezone for new lines (IANA format)
# ULTAURA_DEFAULT_TIMEZONE=America/Los_Angeles

# Enable call recording via Twilio (default: false)
# ULTAURA_ENABLE_RECORDING=false

# CORS allowed origins (comma-separated)
# ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Observability (recommended for production)
# SENTRY_DSN=
# LOG_LEVEL=info

# Admin MFA enforcement (default: true in production, false otherwise)
# Set to "true" to require AAL2 (MFA) for SuperAdmin access
# ADMIN_ENFORCE_MFA=true

# Security alert fallback (Next.js)
# SECURITY_ALERT_ADMIN_EMAIL=security@your-domain.com

# Trusted Device: HMAC secret for signing trusted-device cookies (256-bit hex)
# Allows users to skip MFA on recognized devices for 30 days
# Generate with: openssl rand -hex 32
TRUSTED_DEVICE_SECRET=

# ============================================
# DEVELOPMENT ONLY
# ============================================

# Skip phone verification in development (NOT for production!)
# SKIP_PHONE_VERIFICATION=false

# Use Twilio test credentials
# TWILIO_TEST_MODE=false

# ─── Newsletter (Resend) ───────────────────────────────────────────
RESEND_API_KEY=re_xxxxx
RESEND_SEGMENT_ID=seg_xxxxx
RESEND_TOPIC_BLOG_DIGEST_ID=topic_xxxxx
RESEND_TOPIC_ELDER_CARE_TIPS_ID=topic_xxxxx
RESEND_TOPIC_PRODUCT_UPDATES_ID=topic_xxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxx
RESEND_FROM_EMAIL=Ultaura <newsletter@ultaura.com>

ULTAURA_LOG_PII_KEY=
