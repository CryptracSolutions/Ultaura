{
  "output": {
    "filePath": "Ultaura.xml",
    "style": "xml"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",
    "src/**/*.mjs",
    "src/**/*.css",
    "src/**/*.mdx",
    "telephony/src/**",
    "telephony/package.json",
    "telephony/tsconfig.json",
    "telephony/Dockerfile",
    "telephony/vitest.config.ts",
    "supabase/migrations/**/*.sql",
    "supabase/tests/**/*.sql",
    "supabase/seed.sql",
    "supabase/config.toml",
    "packages/*/src/**",
    "packages/*/package.json",
    "packages/*/tsconfig.json",
    "plugins/**/*.ts",
    "plugins/**/*.tsx",
    "plugins/**/*.sql",
    "plugins/**/*.mdx",
    "plugins/**/package.json",
    "plugins/**/README.md",
    "cypress/**/*.ts",
    "cypress/**/*.js",
    "cypress/.eslintrc.js",
    "cypress/tsconfig.json",
    "scripts/**",
    "prompts/**/*.md",
    "public/locales/**/*.json",
    "public/manifest.json",
    "public/robots.txt",
    "public/sitemap*.xml",
    ".github/workflows/**",
    ".vscode/*.json",
    "package.json",
    "tsconfig.json",
    "next.config.js",
    "tailwind.config.js",
    "postcss.config.js",
    "contentlayer.config.js",
    "vitest.config.ts",
    "cypress.config.ts",
    "next-sitemap.config.js",
    "components.json",
    "pnpm-workspace.yaml",
    ".eslintrc.json",
    ".npmrc",
    "global.d.ts",
    "next-env.d.ts",
    "*.md",
    ".env.ultaura.example",
    ".env.development",
    ".env.production",
    ".env.test",
    ".gitignore",
    "supabase/.gitignore",
    "plugins/**/indexed-files.json"
  ],
  "ignore": {
    "customPatterns": [
      "**/*.svg",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.webp",
      "**/*.ico",
      "**/*.gif",
      "**/*.mp4",
      "**/*.mp3",
      "**/*.woff",
      "**/*.woff2",
      "**/*.ttf",
      "**/*.eot",
      "**/node_modules/**",
      "**/.next/**",
      "**/dist/**",
      "**/.turbo/**",
      "**/.git/**",
      "**/*.tsbuildinfo",
      "**/*.map",
      "**/pnpm-lock.yaml",
      "**/.DS_Store",
      "**/.contentlayer/**",
      "**/coverage/**",
      ".claude/settings.local.json",
      "**/.env",
      "**/.env.local",
      "**/*.lock",
      "**/*.bak",
      "**/.temp/**",
      "**/.branches/**",
      "**/*.swp",
      "**/*.swo",
      "**/*~",
      "spec.md"
    ]
  }
}
