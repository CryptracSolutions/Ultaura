{
  "output": {
    "filePath": "Ultaura.xml",
    "style": "xml"
  },
  "include": [
    "src/lib/ultaura/**",
    "src/database.types.ts",
    "src/components/ultaura/**",
    "src/navigation.config.tsx",
    "packages/prompts/src/**",
    "packages/schemas/src/**",
    "packages/types/src/**",
    "telephony/src/**",
    "telephony/package.json",
    "telephony/Dockerfile",
    "package.json",
    ".env.ultaura.example"
  ],
  "ignore": {
    "customPatterns": [
      "**/*.svg",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.webp",
      "**/*.ico",
      "**/*.gif",
      "**/node_modules/**",
      "**/.next/**",
      "**/dist/**",
      "**/*.map",
      "**/.DS_Store",
      "**/.env",
      "**/.env.local",
      "**/__tests__/**",
      "**/*.test.ts",
      "**/*.spec.ts"
    ]
  }
}
