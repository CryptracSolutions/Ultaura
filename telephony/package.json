{
  "name": "@ultaura/telephony",
  "version": "1.0.0",
  "description": "Ultaura Telephony Backend - Twilio and xAI Grok Voice Agent Bridge",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run -c vitest.config.ts",
    "typecheck": "tsc --noEmit"
