    "@types/luxon": "^3.4.2",
    "@types/ws": "^8.5.10",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.7",
    "@types/node-cron": "^3.0.11",
    "@types/cors": "^2.8.17",
